<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><title>Distributor Enquiry Received</title></head>
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:'Segoe UI',Tahoma,Arial,sans-serif;color:#1f2d3d;">
  <table width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:8px;overflow:hidden;">
    <tr><td style="background:#0f3d6e;color:#ffffff;padding:20px 28px;">
      <h2 style="margin:0;font-size:20px;"><%= company %></h2>
    </td></tr>
    <tr><td style="padding:28px;">
      <p style="margin:0 0 14px;font-size:16px;">Hello <%= contact_person %>,</p>
      <p style="margin:0 0 14px;font-size:14px;line-height:1.6;">
        Thank you for your interest in partnering with <%= company %>. We have received the enquiry
        for <strong><%= company_name %></strong> and our team will review it and get back to you shortly.
      </p>
      <table width="100%" cellpadding="6" cellspacing="0" style="font-size:14px;background:#f4f5f7;border-radius:6px;">
        <tr><td width="38%" style="color:#6b7785;">Company</td><td><%= company_name %></td></tr>
        <tr><td style="color:#6b7785;">Location</td><td><%= city_region %>, <%= country %></td></tr>
        <tr><td style="color:#6b7785;">Products of Interest</td><td><%= products_of_interest.join(", ") %></td></tr>
        <tr><td style="color:#6b7785;">Submitted</td><td><%= submittedDate %></td></tr>
      </table>
      <p style="margin:20px 0 0;font-size:13px;color:#6b7785;">Regards,<br /><%= company %> Team</p>
    </td></tr>
  </table>
</body>
</html>
